{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "secrets",
  "description": "Вход и выход: сохранить/стереть токен Яндекса, открыть окно входа, узнать, где хранятся секреты. Сами токены в интерфейс не отдаются.",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-token-exists",
    "allow-token-store",
    "allow-token-clear",
    "allow-yandex-login",
    "allow-secret-backend",
    "allow-wa-token-exists",
    "allow-wa-token-set",
    "allow-wa-token-clear",
    "allow-wa-auth-request-code",
    "allow-wa-auth-issue"
  ]
}
