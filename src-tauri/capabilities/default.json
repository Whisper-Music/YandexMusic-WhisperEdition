{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Разрешения главного окна",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.yandex.net" },
        { "url": "https://*.yandex.ru" },
        { "url": "https://*.yandex.com" }
      ]
    }
  ]
}
