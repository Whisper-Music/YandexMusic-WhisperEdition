{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Главное окно, интерфейс и система: окно, трей, горячие клавиши, сон, темы, фон, скачанные треки, OBS, Discord. Окно входа Яндекса и любые внешние страницы прав не получают (remote-адресов нет ни в одном файле capabilities).",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://oauth.yandex.ru/*"
        },
        {
          "url": "https://plus.yandex.ru/*"
        },
        {
          "url": "https://github.com/Whisper-Music/YandexMusic-WhisperEdition/releases/*"
        },
        {
          "url": "https://github.com/Whisper-Music/whisper-themes"
        },
        {
          "url": "https://github.com/Whisper-Music/whisper-themes/*"
        }
      ]
    },
    "allow-win-minimize",
    "allow-win-toggle-max",
    "allow-win-is-max",
    "allow-win-close",
    "allow-win-drag",
    "allow-win-set-fullscreen",
    "allow-tray-playing",
    "allow-tray-mode",
    "allow-mini-state",
    "allow-desktop-wallpaper",
    "allow-download-track",
    "allow-downloaded-ids",
    "allow-downloaded-tracks",
    "allow-downloaded-meta",
    "allow-download-dir-get",
    "allow-download-dir-pick",
    "allow-download-dir-reset",
    "allow-download-dir-open",
    "allow-bg-dir-pick",
    "allow-bg-read",
    "allow-theme-save",
    "allow-themelib-fetch",
    "allow-discord-config",
    "allow-discord-status",
    "allow-discord-retry",
    "allow-discord-update",
    "allow-hotkeys-set",
    "allow-sleep-start",
    "allow-sleep-cancel",
    "allow-sleep-status",
    "allow-lyrics-lrclib",
    "allow-thumbbar-state",
    "allow-obs-config",
    "allow-obs-state",
    "allow-obs-theme",
    "allow-update-check",
    "allow-update-install"
  ]
}
