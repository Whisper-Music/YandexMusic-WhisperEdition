{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "archive",
  "description": "Whisper Archive: свои альбомы, альбом по id, профиль, поток трека, сохранение трека (с лимитом частоты), комнаты «Слушать вместе», синхронизация своих треков (библиотека). Путь к API собирает Rust.",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-wa-albums-mine",
    "allow-wa-album",
    "allow-wa-album-share",
    "allow-wa-invite-open",
    "allow-wa-me",
    "allow-wa-stream",
    "allow-wa-prefetch",
    "allow-wa-save-track",
    "allow-studio-to-archive",
    "allow-studio-room-cache",
    "allow-wa-lib-list",
    "allow-wa-lib-changes",
    "allow-wa-friends-list",
    "allow-wa-friends-search",
    "allow-wa-friend-request",
    "allow-wa-friend-accept",
    "allow-wa-friend-remove",
    "allow-wa-friend-block",
    "allow-wa-friend-unblock",
    "allow-wa-user-profile",
    "allow-wa-my-profile",
    "allow-wa-my-nickname",
    "allow-wa-my-avatar",
    "allow-wa-my-avatar-remove",
    "allow-wa-image",
    "allow-studio-lib-upload",
    "allow-studio-lib-restore",
    "allow-drop-audio-archive",
    "allow-wa-room-cache-track",
    "allow-wa-room-create",
    "allow-wa-room-get",
    "allow-wa-room-join",
    "allow-wa-room-leave",
    "allow-wa-room-state",
