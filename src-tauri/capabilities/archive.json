{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "archive",
  "description": "Whisper Archive: свои альбомы, альбом по id, профиль, поток трека, сохранение трека (с лимитом частоты), комнаты «Слушать вместе». Путь к API собирает Rust.",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-wa-albums-mine",
    "allow-wa-album",
    "allow-wa-album-share",
    "allow-wa-me",
    "allow-wa-stream",
    "allow-wa-prefetch",
    "allow-wa-save-track",
    "allow-studio-to-archive",
    "allow-studio-room-cache",
    "allow-wa-room-cache-track",
    "allow-wa-room-create",
    "allow-wa-room-get",
    "allow-wa-room-join",
    "allow-wa-room-leave",
    "allow-wa-room-state",
    "allow-wa-room-suggest",
    "allow-wa-room-dismiss",
    "allow-wa-room-transfer",
    "allow-wa-room-ping",
    "allow-wa-room-missing",
    "allow-wa-room-wink",
    "allow-wa-room-friends",
    "allow-wa-room-friend-forget",
    "allow-wa-room-invite",
    "allow-wa-room-invites",
    "allow-wa-room-invite-dismiss",
    "allow-wa-room-theme-share",
    "allow-wa-room-theme-get",
    "allow-wa-room-theme-remove",
    "allow-room-link-take",
    "allow-open-link-take"
  ]
}
