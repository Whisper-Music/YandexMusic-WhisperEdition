{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yandex-desktop",
  "version": "0.1.0",
  "identifier": "ya",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "yandex-desktop",
        "width": 800,
        "height": 600,
        "minWidth": 780,
        "minHeight": 540,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://*.yandex.net https://*.yandex.ru",
        "media-src": "'self' blob: https://*.yandex.net http://wa.localhost wa://localhost http://ymlocal.localhost ymlocal://localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data: blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1", "gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      },
      "rpm": {
        "depends": ["libayatana-appindicator-gtk3", "gstreamer1-plugins-good"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
