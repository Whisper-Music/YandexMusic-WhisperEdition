{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yandex-desktop",
  "version": "0.6.0",
  "identifier": "ya",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "yandex-desktop",
        "width": 800,
        "height": 600,
        "minWidth": 780,
        "minHeight": 540,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": ["default", "yandex-read", "yandex-write", "secrets", "archive", "mini"],
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' blob:",
        "img-src": "'self' data: blob: https://*.yandex.net https://*.yandex.ru https://cdn.discordapp.com/avatars/",
        "media-src": "'self' blob: https://*.yandex.net http://wa.localhost wa://localhost http://ymlocal.localhost ymlocal://localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data: blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2NzQ4MjVGMEExRDRDM0QKUldROVRCMEtYNEowRmo0VWpRN2NCdE5kei9WL1VjUVJZdy9LZ3d0akwwWGk1b2NxSUtYQ2dWakYK",
      "endpoints": [
        "https://github.com/Whisper-Music/YandexMusic-WhisperEdition/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["whisper"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1", "gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      },
      "rpm": {
        "depends": ["libayatana-appindicator-gtk3", "gstreamer1-plugins-good"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
